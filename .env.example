# JobScout — variables d'environnement (cp .env.example .env puis compléter).
# Le fichier .env est chargé par le service backend (docker-compose: env_file).
# Ne JAMAIS committer le .env réel.
#
# La plupart des réglages ci-dessous migrent vers la page Paramètres du webui
# (config/settings.json, rechargée à chaud) dès le premier démarrage : les
# valeurs ici ne servent plus que de DÉFAUTS initiaux. Les clés API peuvent
# rester ici (lues en fallback) ou être saisies dans la page Paramètres.

# ── Clés API (fallback si non saisies dans la page Paramètres) ──────────────
# Scoring LLM — activer/ordonner les providers dans la page Paramètres.
# Groq (gratuit) : https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (fallback gratuit) : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Providers payants optionnels :
# ANTHROPIC_API_KEY=          # https://console.anthropic.com/settings/keys (claude-haiku-4-5)
# OPENAI_API_KEY=             # https://platform.openai.com/api-keys (gpt-4o-mini)
# GEMINI_API_KEY=             # https://aistudio.google.com/apikey (gemini-2.5-flash)
# France Travail (connecteur API officielle) : https://francetravail.io
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# WTTJ Algolia (optionnel — défauts publics intégrés) :
# WTTJ_ALGOLIA_APP_ID=
# WTTJ_ALGOLIA_KEY=

# ── Défauts au premier boot (ensuite gérés par la page Paramètres) ──────────
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_RPM=6
# OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_FALLBACK_RPM=18
# SCORING_CONCURRENCY=1
# SCORING_RETRIES=3
# REFRESH_INTERVAL_HOURS=24
# RUN_ON_STARTUP=false
# JOB_RETENTION_DAYS=90
# JOB_NOT_SEEN_DAYS=14
# SCRAPE_LOG_KEEP=100

# ── Réglages restés env-only (rarement modifiés) ─────────────────────────────
# SCHEDULED_PROFILES=France
# PLAYWRIGHT_ENABLED=false   # connecteurs Playwright — lourd sur le NAS
# FT_ROME_CODES=M1802,M1803,M1806,M1810
# FT_QUALIFICATION=9         # 9 = cadre ; "" pour désactiver
# IDF_DEPARTMENTS=75,77,78,91,92,93,94,95
# GREENHOUSE_BOARDS=         # slugs de boards Greenhouse, séparés par virgule
# WORKDAY_SITES=             # tenants Workday, séparés par virgule
# CSP_DOMAINS=3522           # Choisir le Service Public — domaine(s) SI
# WTTJ_ALGOLIA_APP_ID=
# WTTJ_ALGOLIA_KEY=
# WTTJ_ALGOLIA_INDEX=
# OPENROUTER_SITE_URL=http://localhost:8502
# OPENROUTER_APP_NAME=JobScout

# ── Divers ───────────────────────────────────────────────────────────────────
# DB_PATH=/data/jobs.db
# CONFIG_DIR=/app/config
# ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8502
# EXCLUDED_COMPANIES=        # blacklist entreprises additionnelle (virgules)
# LOG_LEVEL=INFO
