# ============================================================================
# JobScout — fichier d'exemple .env
# Copier en .env et remplir. Docker Compose lit .env automatiquement.
# ============================================================================

# ---- Provider scoring (Groq primary + OpenRouter fallback) -----------------
# Groq : récupère ta clé sur https://console.groq.com/keys (gratuit, 30 RPM)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
# Limite réelle : 6000 TPM avec ~1800 tokens/call → ~3 calls/min sustainable.
# 6 RPM = espacement de 10s, garde une marge confortable.
GROQ_RPM=6

# Fallback automatique si Groq échoue (429, 5xx, etc.)
# Récupère ta clé sur https://openrouter.ai/keys (gratuit pour le modèle :free)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_RPM=18

# Concurrence des appels scoring (1 = séquentiel, recommandé pour free tiers)
SCORING_CONCURRENCY=1

# Optionnel : analytics OpenRouter
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=JobScout

# ---- Scheduler -------------------------------------------------------------
# Intervalle entre 2 cycles de scrape automatique (heures)
REFRESH_INTERVAL_HOURS=24

# Profils géographiques scrapés à chaque cycle.
# Liste possible : France, Suisse, Luxembourg, Belgique, Canada (QC), La Réunion, Martinique
# (séparés par virgule, sensibles à la casse)
SCHEDULED_PROFILES=France

# Lance un scrape 30s après le boot du container ? (true/false)
RUN_ON_STARTUP=false

# ---- Rétention DB ----------------------------------------------------------
# Purge nocturne (03:00 UTC) des offres > N jours non interactives (sans Kanban / archive)
JOB_RETENTION_DAYS=30

# Nombre de scrape_logs conservés (rotation au nettoyage quotidien)
SCRAPE_LOG_KEEP=100

# ---- Sécurité --------------------------------------------------------------
# Origines CORS autorisées (séparées par virgule). "*" pour tout autoriser (déconseillé).
ALLOWED_ORIGINS=http://localhost:8501

# ---- FranceTravail API (optionnel) -----------------------------------------
# Inscris-toi sur https://francetravail.io/data/api → souscris à "Offres d'emploi"
# FT_CLIENT_ID=PAR_YOURAPP_xxxxxxxxxxxxxxxxxxxxxxxxx
# FT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Greenhouse boards (optionnel) -----------------------------------------
# Slugs séparés par virgule (URL: https://boards.greenhouse.io/{slug})
# GREENHOUSE_BOARDS=okta,cloudflare,zscaler,beyondtrust,elastic,datadog,gitlab

# ---- Workday sites (optionnel) ---------------------------------------------
# Format: CompanyName|https://tenant.wdN.myworkdayjobs.com/site-id (séparés par ;)
# WORKDAY_SITES=PaloAlto|https://paloaltonetworks.wd5.myworkdayjobs.com/PaloAltoNetworks

# ---- Playwright (APEC + autres scrapers JS-heavy) -------------------------
# APEC nécessite désormais un compte authentifié (login wall) — laissé désactivé.
# PLAYWRIGHT_ENABLED=false
