# Copy to .env and fill in. Docker Compose reads .env automatically.

# REQUIRED: OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for relevance scoring. Default: anthropic/claude-haiku-4.5 (fast & cheap).
SCORING_MODEL=anthropic/claude-haiku-4.5

# Optional OpenRouter analytics metadata.
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=JobScout

# Scheduler interval (hours). Default 24 (section 7 — scrape quotidien).
REFRESH_INTERVAL_HOURS=24

# Which geographic profiles the scheduler scrapes each interval.
# Comma-separated subset of: France, Suisse, Luxembourg, Belgique, Canada (QC), La Réunion, Martinique.
# Leave as "France" to limit cost; use "France,Suisse,Luxembourg,Belgique" for EU-wide coverage.
SCHEDULED_PROFILES=France

# Run a scrape 30s after container start. Default true.
RUN_ON_STARTUP=true

# Parallel scoring requests. Higher = faster but hits rate limits sooner.
SCORING_CONCURRENCY=4

# ---- Telegram (notifications) ----
# TELEGRAM_BOT_TOKEN=xxxxxxxxx:AAA-BBB-CCC
# TELEGRAM_CHAT_ID=1234567890
# TELEGRAM_MIN_SCORE=7

# ---- FranceTravail API (custom connector) ----
# Register at https://francetravail.io/data/api, subscribe to "Offres d'emploi", get creds.
# Silently disabled when unset.
# FT_CLIENT_ID=PAR_yourapp_xxxxxxxxxxxxxxxxxxxxxxxxx
# FT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Greenhouse ATS boards (public) ----
# Comma-separated company slugs. Look at a company career URL on boards.greenhouse.io/{slug}
# Silently disabled when empty.
# GREENHOUSE_BOARDS=sentinelone,anthropic,paloaltonetworks

# ---- Workday careers sites ----
# Semicolon-separated entries of the form: CompanyName|https://tenant.wdN.myworkdayjobs.com/site-id
# Silently disabled when empty.
# WORKDAY_SITES=PaloAlto|https://paloaltonetworks.wd5.myworkdayjobs.com/PaloAltoNetworks;Fortinet|https://fortinet.wd1.myworkdayjobs.com/Fortinet_Careers

# ---- Playwright-based scrapers (APEC, and later WTTJ/JobUp/Stepstone) ----
# Enable only if you accept the ~2-5s per page overhead on the NAS Celeron.
# When false, the APEC connector (and other Playwright-backed ones) self-disable.
# PLAYWRIGHT_ENABLED=true
